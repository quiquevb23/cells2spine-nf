# docker/r-enrichment/Dockerfile
FROM bioconductor/bioconductor_docker:RELEASE_3_20

WORKDIR /workspace
COPY envs/renv-enrichment.lock ./renv.lock
COPY envs/activate-enrichment.R ./renv/activate.R

RUN R -e "install.packages('renv', repos = 'https://cloud.r-project.org')" && \
    R -e "renv::restore(lockfile = 'renv.lock', confirm = FALSE)"

COPY r_scripts/GSEA.R r_scripts/ORA.R /usr/local/bin/
RUN chmod +x /usr/local/bin/*.R

ENTRYPOINT ["Rscript"]
