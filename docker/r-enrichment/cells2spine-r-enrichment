# docker/r-enrichment/Dockerfile
FROM bioconductor/bioconductor_docker:RELEASE_3_20

WORKDIR /workspace
COPY envs/renv-enrichment.lock ./renv.lock
COPY r_scripts/renv/activate.R ./renv/activate.R

RUN R -e "renv::restore(lockfile = 'renv.lock', confirm = FALSE)"

COPY r_scripts/GSEA.R r_scripts/ORA.R r_scripts/ct_genexpr.R /usr/local/bin/
RUN chmod +x /usr/local/bin/*.R

ENTRYPOINT ["Rscript"]
