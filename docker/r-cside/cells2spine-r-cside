# docker/r-cside/Dockerfile
FROM rocker/r-ver:4.4.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        libopenblas-dev \
        liblapack-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libgit2-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        pandoc \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages('renv', repos='https://cloud.r-project.org')"

WORKDIR /workspace
COPY envs/renv-cside.lock ./renv.lock
COPY envs/activate-cside.R ./renv/activate.R

# Bake the exact CSIDE-side dependency graph (including spacexr @ 698d5b0)
# into the image at BUILD time — no network calls, no drift at runtime.
RUN R -e "renv::restore(lockfile = 'renv.lock', confirm = FALSE)"

COPY bin/CSIDE.R /usr/local/bin/CSIDE.R
RUN chmod +x /usr/local/bin/CSIDE.R

ENTRYPOINT ["Rscript"]
