# docker/rpy2/Dockerfile
FROM condaforge/mambaforge:23.3.1-1

WORKDIR /opt/build
COPY envs/rpy2_env.yml .

RUN mamba env create -f rpy2_env.yml -n rpy2_env \
    && mamba clean --all --yes

# Activate the env for all subsequent RUN/ENTRYPOINT layers
SHELL ["mamba", "run", "-n", "rpy2_env", "/bin/bash", "-c"]
ENV PATH=/opt/conda/envs/rpy2_env/bin:$PATH

WORKDIR /workspace
COPY bin/ct_gene_expr.py \
     bin/differential_abundance_.py \
     bin/compare_cell2loc_rctd.py \
     bin/compare_DEGs.py \
     bin/compare_FE.py \
     bin/compare_gene_expr.py \
     bin/plot_global_FE_heatmaps.py \
     bin/validate_per_area_pseudobulk.py \
     bin/validate_per_celltype.py \
     bin/DEG_areas_pipeline.py \
     bin/VolcanoPlot_DEG_pipeline.py \
     /usr/local/bin/

RUN chmod +x /usr/local/bin/*.py

ENTRYPOINT ["mamba", "run", "-n", "rpy2_env", "python3"]
