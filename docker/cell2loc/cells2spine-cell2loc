FROM condaforge/mambaforge:23.3.1-1

WORKDIR /opt/build

COPY envs/cell2loc_env.yml .

# Let Mamba handle the entire environment solve
RUN mamba env create -f cell2loc_env.yml -n cell2loc_env \
    && mamba clean --all --yes

SHELL ["mamba", "run", "-n", "cell2loc_env", "/bin/bash", "-c"]
ENV PATH=/opt/conda/envs/cell2loc_env/bin:$PATH

WORKDIR /workspace

COPY bin_python_staging/cell2loc_owndata.py \
     bin_python_staging/conversor_ref.py \
     bin_python_staging/conversor.py \
     /usr/local/bin/

RUN chmod +x /usr/local/bin/*.py

ENTRYPOINT ["mamba", "run", "-n", "cell2loc_env", "python3"]
