manifest {
    name            = 'cells2spine-nf'
    author          = 'quiquevb'
    description     = 'Spatial Deconvolution, CSIDE, Enrichment & maSigPro Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
}

params {
    outdir = "./results"

    // GHCR Container Images
    container_cell2loc   = 'ghcr.io/quiquevb23/cells2spine-cell2loc:latest'
    container_rpy2       = 'ghcr.io/quiquevb23/cells2spine-rpy2:latest'
    container_cside      = 'ghcr.io/quiquevb23/cells2spine-r-cside:latest'
    container_enrichment = 'ghcr.io/quiquevb23/cells2spine-r-enrichment:latest'

    // Pipeline Inputs
    gene_list            = null

    masigpro = [:]

}

// Resource Allocation Profiles
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = '128 GB'
        time   = '24h'
    }
    withLabel: 'process_gpu' {
        cpus   = 8
        memory = '48 GB'
        time   = '12h'
    }
    // One cell2location mapping job per spatial sample (CELL2LOC_MAP)
    withLabel: 'process_cell2loc_map' {
        cpus   = 8
        memory = '64 GB'
        time   = '24h'
    }
}

// Execution Profiles
profiles {
    standard {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${projectDir}/singularity_build_tmp/cache"
        singularity.envWhitelist = 'SINGULARITY_DOCKER_USERNAME,SINGULARITY_DOCKER_PASSWORD'
        singularity.pullTimeout  = '8h'
        env.NUMBA_CACHE_DIR      = '/tmp/numba_cache'
        env.MPLCONFIGDIR         = '/tmp/matplotlib'
        env.XDG_CACHE_HOME       = '/tmp/xdg_cache'
        // torch>=2.6 defaults torch.load(weights_only=True); scvi's model.pt needs full unpickling
        env.TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD = '1'
        process {
            withLabel: 'process_low' {
                cpus   = 2
                memory = '8 GB'
                time   = '2h'
                clusterOptions = '--account=gge --qos=short'
            }
            withLabel: 'process_medium' {
                cpus   = 8
                memory = '32 GB'
                time   = '8h'
                clusterOptions = '--account=gge --qos=short'
            }
            withLabel: 'process_high' {
                cpus   = 16
                memory = '128 GB'
                time   = '24h'
                clusterOptions = '--account=gge --qos=long'
            }
            withLabel: 'process_gpu' {
                cpus   = 8
                memory = '48 GB'
                time   = '12h'
                clusterOptions = '--account=gge --qos=long --gres=gpu:1'
            }
            // cell2location sizes from sacct MaxRSS (2026-11-24/27): MAP peaked at
            // 2.4-4.9 GB in ~22 min, a one-condition REFERENCE at 3.3-5.2 GB in
            // 15-26 min. Requests count against QOSMaxMemoryPerUser on `long`
            // (at 64/128 GB only 2-3 jobs ran at once), so ask for ~3x the peak
            // and retry with 2x / 3x memory if Slurm kills a task for memory.
            withLabel: 'process_cell2loc_map' {
                cpus   = 8
                memory = { 16.GB * task.attempt }
                time   = '4h'
                errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
                maxRetries    = 2
                clusterOptions = '--account=gge --qos=long'
            }
            // group references pool 2 conditions (~2x cells), 'pooled' all of them
            withName: 'CELL2LOC_REFERENCE' {
                memory = { 32.GB * task.attempt }
                time   = '6h'
                errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
                maxRetries    = 2
            }
            // CSIDE peaked at 10.6 GB with 2 samples (job 3510247); 48 GB leaves
            // headroom for more samples while scheduling faster than 128 GB.
            // Re-tune from MaxRSS after the 15-sample run.
            withName: 'CSIDE' {
                memory = '48 GB'
            }
        }
    }
    stub {
        process {
            withLabel: 'process_low'    { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_medium' { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_high'   { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_gpu'    { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_cell2loc_map' { cpus = 1; memory = '1 GB'; time = '10m' }
        }
        docker.enabled = false
    }
}
