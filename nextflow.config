manifest {
    name            = 'cells2spine-nf'
    author          = 'quiquevb'
    description     = 'Spatial Deconvolution, CSIDE, Enrichment & maSigPro Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
}

params {
    outdir = "./results"

    // GHCR Container Images
    container_cell2loc   = 'ghcr.io/quiquevb23/cells2spine-cell2loc:latest'
    container_rpy2       = 'ghcr.io/quiquevb23/cells2spine-rpy2:latest'
    container_cside      = 'ghcr.io/quiquevb23/cells2spine-r-cside:latest'
    container_enrichment = 'ghcr.io/quiquevb23/cells2spine-r-enrichment:latest'

    // Pipeline Inputs
    gene_list            = null

    masigpro = [:]

}

// Resource Allocation Profiles
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = '128 GB'
        time   = '24h'
    }
    withLabel: 'process_gpu' {
        cpus   = 8
        memory = '48 GB'
        time   = '12h'
    }
}

// Execution Profiles
profiles {
    standard {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${projectDir}/singularity_build_tmp/cache"
        singularity.envWhitelist = 'SINGULARITY_DOCKER_USERNAME,SINGULARITY_DOCKER_PASSWORD'
        singularity.pullTimeout  = '8h'
        env.NUMBA_CACHE_DIR      = '/tmp/numba_cache'
        env.MPLCONFIGDIR         = '/tmp/matplotlib'
        process {
            withLabel: 'process_low' {
                cpus   = 2
                memory = '8 GB'
                time   = '2h'
                clusterOptions = '--account=gge --qos=short'
            }
            withLabel: 'process_medium' {
                cpus   = 8
                memory = '32 GB'
                time   = '8h'
                clusterOptions = '--account=gge --qos=short'
            }
            withLabel: 'process_high' {
                cpus   = 16
                memory = '128 GB'
                time   = '24h'
                clusterOptions = '--account=gge --qos=long'
            }
            withLabel: 'process_gpu' {
                cpus   = 8
                memory = '48 GB'
                time   = '12h'
                clusterOptions = '--account=gge --qos=long --gres=gpu:1'
            }
        }
    }
    stub {
        process {
            withLabel: 'process_low'    { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_medium' { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_high'   { cpus = 1; memory = '1 GB'; time = '10m' }
            withLabel: 'process_gpu'    { cpus = 1; memory = '1 GB'; time = '10m' }
        }
        docker.enabled = false
    }
}
